#define XPC_PATH_1 "/usr/lib/system/libxpc.dylib"
#define XPC_PATH_2 "/usr/lib/libxpc.dylib"

#ifdef __arm64__
#define HOOK_SIZE 16
#else
#define HOOK_SIZE 12
#endif

typedef void (*xpc_send_msg_t)(xpc_connection_t, xpc_object_t);
typedef xpc_object_t (*xpc_send_reply_t)(xpc_connection_t, xpc_object_t);
typedef xpc_connection_t (*xpc_conn_create_t)(const char *);

static xpc_send_msg_t orig_send_msg = NULL;
static xpc_send_reply_t orig_send_reply = NULL;
static xpc_conn_create_t orig_conn_create = NULL;

static pthread_mutex_t log_mutex = PTHREAD_MUTEX_INITIALIZER;
static uint64_t intercept_count = 0;
static uint64_t error_count = 0;

void hex_dump(const void *data, size_t size) {
    const unsigned char *ptr = (const unsigned char *)data;
    size_t i;
    char ascii[17];
    ascii[16] = '\0';
    for (i = 0; i < size; ++i) {
        if ((i % 16) == 0) {
            printf("  %08zx: ", i);
        }
        printf("%02x ", ptr[i]);
        if (ptr[i] >= ' ' && ptr[i] <= '~') {
            ascii[i % 16] = ptr[i];
        } else {
            ascii[i % 16] = '.';
        }
        if ((i + 1) % 8 == 0 || i + 1 == size) {
            printf(" ");
            if ((i + 1) % 16 == 0) {
                printf("|  %s \n", ascii);
            } else if (i + 1 == size) {
                ascii[(i + 1) % 16] = '\0';
                if ((i + 1) % 16 <= 8) {
                    printf(" ");
                }
                for (size_t j = (i + 1) % 16; j < 16; ++j) {
                    printf("   ");
                }
                printf("|  %s \n", ascii);
            }
        }
    }
}

uint64_t get_timestamp_ms() {
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return (uint64_t)(ts.tv_sec) * 1000 + (ts.tv_nsec / 1000000);
}

void safe_log(const char *tag, const char *message) {
    pthread_mutex_lock(&log_mutex);
    log_xpc_message(tag, message);
    pthread_mutex_unlock(&log_mutex);
}

int patch_memory(void *address, const uint8_t *patch, size_t patch_size) {
    if (!address) return -1;
    kern_return_t kr;
    vm_address_t page = (vm_address_t)address & ~(PAGE_SIZE - 1);
    vm_size_t page_size = PAGE_SIZE;
    
    kr = vm_protect(mach_task_self(), page, page_size, FALSE, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE);
    if (kr != KERN_SUCCESS) {
        return -1;
    }
    
    memcpy(address, patch, patch_size);
    
    kr = vm_protect(mach_task_self(), page, page_size, FALSE, VM_PROT_READ | VM_PROT_EXECUTE);
    if (kr != KERN_SUCCESS) {
        return -1;
    }
    
    return 0;
}

void generate_trampoline(void *target, void *hook_func, uint8_t *out_patch) {
    memset(out_patch, 0, HOOK_SIZE);
#ifdef __arm64__
    uint64_t addr = (uint64_t)hook_func;
    out_patch[0] = 0x50; // LDR x16, #8
    out_patch[1] = 0x00;
    out_patch[2] = 0x00;
    out_patch[3] = 0x58;
    memcpy(&out_patch[4], &addr, 8);
    out_patch[12] = 0x00; // BR x16
    out_patch[13] = 0x02;
    out_patch[14] = 0x1F;
    out_patch[15] = 0xD6;
#else
    uint64_t addr = (uint64_t)hook_func;
    out_patch[0] = 0x48; // MOVABS rax, imm64
    out_patch[1] = 0xB8;
    memcpy(&out_patch[2], &addr, 8);
    out_patch[10] = 0xFF; // JMP rax
    out_patch[11] = 0xE0;
#endif
}

void hooked_xpc_send(xpc_connection_t connection, xpc_object_t message) {
    __sync_fetch_and_add(&intercept_count, 1);
    
    if (message) {
        char *desc = xpc_copy_description(message);
        if (desc) {
            char log_buffer[4096];
            snprintf(log_buffer, sizeof(log_buffer), "[%llu] MSG: %s", get_timestamp_ms(), desc);
            safe_log("INTERCEPT", log_buffer);
            
            size_t desc_len = strlen(desc);
            if (desc_len > 0) {
                hex_dump(desc, desc_len > 128 ? 128 : desc_len);
            }
            
            free(desc);
        }
    }
    
    if (orig_send_msg) {
        orig_send_msg(connection, message);
    } else {
        __sync_fetch_and_add(&error_count, 1);
    }
}

xpc_object_t hooked_xpc_send_reply(xpc_connection_t connection, xpc_object_t message) {
    __sync_fetch_and_add(&intercept_count, 1);
    
    if (message) {
        char *desc = xpc_copy_description(message);
        if (desc) {
            char log_buffer[4096];
            snprintf(log_buffer, sizeof(log_buffer), "[%llu] SYNC_MSG: %s", get_timestamp_ms(), desc);
            safe_log("INTERCEPT_SYNC", log_buffer);
            free(desc);
        }
    }
    
    if (orig_send_reply) {
        xpc_object_t reply = orig_send_reply(connection, message);
        if (reply) {
            char *reply_desc = xpc_copy_description(reply);
            if (reply_desc) {
                char log_buffer[4096];
                snprintf(log_buffer, sizeof(log_buffer), "[%llu] REPLY: %s", get_timestamp_ms(), reply_desc);
                safe_log("INTERCEPT_REPLY", log_buffer);
                free(reply_desc);
            }
        }
        return reply;
    }
    
    __sync_fetch_and_add(&error_count, 1);
    return NULL;
}

void install_hooks() {
    void *handle = dlopen(XPC_PATH_1, RTLD_LAZY | RTLD_NOLOAD);
    if (!handle) {
        handle = dlopen(XPC_PATH_2, RTLD_LAZY | RTLD_NOLOAD);
    }
    
    if (handle) {
        orig_send_msg = (xpc_send_msg_t)dlsym(handle, "xpc_connection_send_message");
        orig_send_reply = (xpc_send_reply_t)dlsym(handle, "xpc_connection_send_message_with_reply_sync");
        orig_conn_create = (xpc_conn_create_t)dlsym(handle, "xpc_connection_create_mach_service");
        
        if (orig_send_msg) {
            uint8_t patch[HOOK_SIZE];
            generate_trampoline((void *)orig_send_msg, (void *)hooked_xpc_send, patch);
            patch_memory((void *)orig_send_msg, patch, HOOK_SIZE);
        }
        
        if (orig_send_reply) {
            uint8_t patch[HOOK_SIZE];
            generate_trampoline((void *)orig_send_reply, (void *)hooked_xpc_send_reply, patch);
            patch_memory((void *)orig_send_reply, patch, HOOK_SIZE);
        }
    }
}

void start_interceptor(const char *target_service) {
    printf(" Starting XPC Interceptor for: %s\n", target_service);
    printf(" Resolving dependencies...\n");
    
    install_hooks();
    
    printf(" Hooks installed");
    
    while (1) {
        sleep(5);
        if (intercept_count > 0) {
            char status[256];
            snprintf(status, sizeof(status), "Status: %llu intercepted, %llu errors", intercept_count, error_count);
            safe_log("STATUS", status);
        }
    }
}